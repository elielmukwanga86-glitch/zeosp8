# Copier ce fichier en « .env.local » puis remplir les valeurs.
# Ne JAMAIS committer .env.local (il est ignoré par git).

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clé « publishable » (commence par sb_publishable_) : peut être visible dans le navigateur.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clé « secret » (commence par sb_secret_) : SERVEUR UNIQUEMENT, ne jamais la partager.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- Application ---
# Adresse publique du site (sert à fabriquer les liens des QR codes et des e-mails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret qui signe la session des agents sur leur téléphone (32 caractères minimum).
# Générer avec : openssl rand -base64 48
AGENT_SESSION_SECRET=

# --- E-mails (Resend) ---
# « console » = les e-mails sont affichés dans le terminal au lieu d'être envoyés (développement).
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Expéditeur : doit utiliser un domaine vérifié dans Resend (ou onboarding@resend.dev pour tester).
EMAIL_FROM="PassageVu <onboarding@resend.dev>"

# --- Tâches planifiées (Vercel Cron) ---
# Vercel envoie « Authorization: Bearer <CRON_SECRET> » ; générer avec : openssl rand -hex 32
CRON_SECRET=
