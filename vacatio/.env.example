# ---------------------------------------------------------------------------
# Vacatio — variables d'environnement (copier en .env.local, ne jamais committer)
# ---------------------------------------------------------------------------

# URL publique de l'application (sans / final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API). Région UE obligatoire (eu-west-3 Paris).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement (webhooks, portail client, liens agents).
SUPABASE_SERVICE_ROLE_KEY=

# E-mails transactionnels (Resend) — vide en dev : les e-mails sont affichés dans la console.
RESEND_API_KEY=
EMAIL_FROM="Vacatio <bonjour@vacatio.fr>"

# SMS (Brevo) — vide en dev : les SMS sont affichés dans la console.
BREVO_API_KEY=
SMS_SENDER=Vacatio

# Domaine technique des comptes agents (connexion par lien SMS, aucun e-mail envoyé).
AGENT_EMAIL_DOMAIN=agents.vacatio.fr

# Secret des tâches planifiées Vercel (au moins 16 caractères aléatoires).
# Générer : openssl rand -hex 32
CRON_SECRET=

# Phases suivantes (laisser vide pour l'instant) :
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SENTRY_DSN=
