{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.80", "--browser", "chromium", "--headless", "--isolated", "--output-dir", ".playwright-mcp"]
    },
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@1.3.0"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY:-cle-injectee-par-le-proxy}"
      }
    },
    "composio": {
      "type": "http",
      "url": "https://connect.composio.dev/mcp"
    }
  }
}
